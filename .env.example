# Copiá este archivo a .env para desarrollar. En Easypanel las variables se cargan en el servicio.
# Nunca subas .env.

PORT=3000
# Carpeta de las respuestas y archivos. Vacía = ./data
DIR_DATOS=
# Código del link (https://tu-dominio/?c=CODIGO). Vacío = abierto a quien tenga la dirección.
CODIGO_ACCESO=

# Gmail: SMTP_CLAVE es una contraseña de aplicación (https://myaccount.google.com/apppasswords).
# Sin esto, en local el mail no sale: queda en data/correos para verlo.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
# A quién le llegan las respuestas.
MAIL_AVISO=
